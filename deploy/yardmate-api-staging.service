[Unit]
Description=YardMate API STAGING (App-Attest secret vendor)
Documentation=https://github.com/yaochen1125/yardmate-api/blob/main/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yardmate-api
Group=yardmate-api

# yardmate-api reads /etc/yardmate-api/secrets-staging.env directly via secrets.Load.
# The file is owned by yardmate-api:yardmate-api with mode 0600 — readable only
# by this service. Server-side config env vars are baked into Environment=
# below; bin path is fixed.
Environment=YARDMATE_API_ADDR=127.0.0.1:8081
Environment=YARDMATE_API_DB_PATH=/var/lib/yardmate-api-staging/credentials.db
Environment=YARDMATE_API_SECRETS_PATH=/etc/yardmate-api/secrets-staging.env
Environment=YARDMATE_API_APP_ID=PMX32RG52M.com.chenyao.plantapp
# Staging is a low-traffic verification box: cap in-flight uploads at 4 so peak
# image buffering (4 × ≤8 MB) stays comfortably under the 512M MemoryMax below,
# instead of the prod default of 30 (~480 MB peak) which would OOM-kill here.
Environment=YARDMATE_API_INFLIGHT_MAX=4

ExecStart=/usr/local/bin/yardmate-api-staging
Restart=on-failure
RestartSec=5
TimeoutStopSec=10

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictNamespaces=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectProc=invisible
ProcSubset=pid
UMask=0077
ReadWritePaths=/var/lib/yardmate-api-staging

# systemd creates/chowns the state dir (BoltDB home) before every start —
# covers fresh hosts and accidental deletion; no manual install -d in the
# deploy script.
StateDirectory=yardmate-api-staging
StateDirectoryMode=0750

# Resource caps. Staging shares the box with prod + nginx + catalog-promote, so
# it keeps a tight 512M MemoryMax and pairs it with YARDMATE_API_INFLIGHT_MAX=4
# above (peak image buffering 4 × ≤8 MB ≈ 32 MB, well under the cap). Do NOT copy
# prod's 4G here — this unit intentionally runs lean.
LimitNOFILE=4096
MemoryMax=512M

[Install]
WantedBy=multi-user.target
