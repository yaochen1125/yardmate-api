# proxy_pass to yardmate-api-staging on 127.0.0.1:8081 (ATTEST_ALLOW_DEV=true).
# TLS added by certbot after the api-staging DNS record exists.
server {
    server_name api-staging.yardmate.ai;

    client_max_body_size 9M;

    access_log /var/log/nginx/api-staging.yardmate.ai.access.log;
    error_log  /var/log/nginx/api-staging.yardmate.ai.error.log warn;

    limit_req_status 429;
    limit_conn_status 429;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # 与 prod 同样只放行 /v1/* + /healthz，理由见 api.yardmate.ai 的注释。
    # staging 尤其不能松：这里 ATTEST_ALLOW_DEV=true，本就少一道校验。
    location = /healthz {
        proxy_pass http://127.0.0.1:8081;
    }

    location /v1/ {
        limit_req  zone=api_rl burst=60 nodelay;
        limit_conn api_conn 50;

        proxy_pass http://127.0.0.1:8081;
    }

    location / {
        return 404;
    }

    listen [::]:443 ssl; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/api-staging.yardmate.ai/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/api-staging.yardmate.ai/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}

server {
    if ($host = api-staging.yardmate.ai) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;
    server_name api-staging.yardmate.ai;
    return 404; # managed by Certbot


}
