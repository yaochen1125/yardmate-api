# proxy_pass to yardmate-api on 127.0.0.1:8080 (prod; ATTEST_ALLOW_DEV=false).
server {
    server_name api.yardmate.ai;

    # Match the Go handler's identifyMaxBody (8 MB image + 1 MB multipart
    # overhead). Was 5M, which silently 413'd legitimate 5–8 MB photos before
    # they reached the app; the app's MaxBytesReader is now the single cap.
    client_max_body_size 9M;

    access_log /var/log/nginx/api.yardmate.ai.access.log;
    error_log  /var/log/nginx/api.yardmate.ai.error.log warn;

    # Flood shield (loose — see conf.d/ratelimit.conf). Trips only on volumetric
    # abuse; precise bounds are the Go inflight semaphore + rate limiters. 429 so
    # the iOS client maps it to .rateLimit ("slow down") rather than a hard error.
    limit_req_status 429;
    limit_conn_status 429;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # 公网只放行 /v1/* 和 /healthz —— 这不是收紧，是补上一个一直缺失的前提。
    # server.go 与 imageingest/SPEC.md 都写着 /internal/* 是「internal-only,
    # behind nginx / unreachable externally」，并据此让 /internal/imageingest/run
    # 故意不挂限流中间件。但此前这里是 `location /` 全转发，那个前提根本不成立：
    # 该端点公网可达且零限流，只剩 admin token 一道防线（实测返回 401 而非 404）。
    # 运维要用它就在服务器本机 curl 127.0.0.1:8080 —— 正是 SPEC 假设的调用方式。
    location = /healthz {
        proxy_pass http://127.0.0.1:8080;
    }

    # /v1/doctor 是 SSE 流式端点（doctor/SPEC.md §3）。单独一个 location，因为
    # 精确匹配不继承 /v1/ 前缀块的指令，限流必须重写一遍；额外三件事：
    #   - proxy_buffering off：缓冲会把逐条到达的 observation 事件攒成一坨，
    #     流式退化回 15 秒白等（Go 侧还发 X-Accel-Buffering: no 双保险）
    #   - proxy_read_timeout 200s：默认 60s 对连续输出的流够用，但留出模型
    #     偶发慢启动的余量；Go 侧 streamTimeout=180s 先于它掐断
    #   - proxy_http_version 1.1 + Connection ""：SSE 走 keep-alive 长连接
    location = /v1/doctor {
        limit_req  zone=api_rl burst=60 nodelay;
        limit_conn api_conn 50;

        proxy_buffering    off;
        proxy_read_timeout 200s;
        proxy_http_version 1.1;
        proxy_set_header   Connection "";

        proxy_pass http://127.0.0.1:8080;
    }

    location /v1/ {
        limit_req  zone=api_rl burst=60 nodelay;
        limit_conn api_conn 50;

        proxy_pass http://127.0.0.1:8080;
    }

    # 其余一律不转发（含 /internal/*）。404 而非 403：不确认路径是否存在。
    location / {
        return 404;
    }

    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/api.yardmate.ai/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/api.yardmate.ai/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = api.yardmate.ai) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    listen [::]:80;
    server_name api.yardmate.ai;
    return 404; # managed by Certbot
}
