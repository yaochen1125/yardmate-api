# yardmate-api secrets.env template
#
# COPY this file to a location OUTSIDE this repo (e.g.
# ~/.config/yardmate-api/secrets.env.prod), fill in real values, and point
# deploy.sh at it via YARDMATE_SECRETS=...
#
# NEVER commit a filled version. The repo's .gitignore covers `secrets.env`
# at any depth, but the safest habit is to keep the live copy outside the
# tree entirely.
#
# File format: see secrets/SPEC.md §2.

# ---- server config ----

# App Attest "development environment" gate. See deploy/README.md §3 for the
# stage-aware ship SOP. MUST be `false` once the App Store binary ships.
ATTEST_ALLOW_DEV=false

# ---- vended to authenticated clients ----

# OpenAI API key (GPT-4o-mini for plant chat / advice features).
OPENAI_API_KEY=sk-REPLACE-ME

# Pl@ntNet API key (PRIMARY plant identification engine; Plant.id is fallback).
# Get a free key at https://my.plantnet.org (~500 req/day free tier).
PLANTNET_API_KEY=REPLACE-ME

# Plant.id API key (identification FALLBACK + sole /v1/diagnose engine).
PLANT_ID_API_KEY=REPLACE-ME

# ---- /v1/plants/enrichment (V1 plant-detail enrichment) ----

# Supabase Postgres DSN (Session Pooler form per proxy/enrichment/SPEC §9 #15).
# Get from Supabase Dashboard → Connect → Direct → "Session pooler" tab.
# Replace [YOUR-PASSWORD] with the actual DB password (use "Reset Database
# Password" in Dashboard if forgotten).
#
# DO NOT use the "Direct connection" DSN (db.<ref>.supabase.co:5432) —
# Supabase makes it IPv6-only by default and the Hetzner outbound IPv6 path
# is unreliable, which fails silently as a TCP timeout. Session Pooler is
# IPv4-routable and runs the same Postgres wire protocol so pgx connects
# identically (SPEC §9 #15).
SUPABASE_DB_URL=postgresql://postgres.REPLACE-REF:REPLACE-PASSWORD@aws-0-REPLACE-REGION.pooler.supabase.com:5432/postgres

# ---- proxy/imageingest (out-of-catalog hero-image ingest) ----
#
# Fills plant_images/{slug}/hero.png on Cloudflare R2 from Wikimedia Commons.
# See proxy/imageingest/SPEC.md. SUPABASE_DB_URL (above) is reused (the seed
# read of plants_pending + the plant_image_ingest ledger).
#
# Cloudflare R2 credentials — an R2 API token scoped to *Object Read & Write*
# on the yardmate-static bucket ONLY (no account-wide, no other buckets).
# SERVER-ONLY: never vended to clients (NOT in main.vendedKeys), never logged.
R2_ACCOUNT_ID=REPLACE-ME
R2_ACCESS_KEY_ID=REPLACE-ME
R2_SECRET_ACCESS_KEY=REPLACE-ME
R2_BUCKET=yardmate-static
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com   (optional; derived from R2_ACCOUNT_ID if unset)

# Internal manual-trigger gate for POST /internal/imageingest/run. SERVER-ONLY,
# NOT vended. The route is registered only when this is set; the request must
# carry it as the X-Ingest-Admin-Token header (constant-time compared).
IMAGEINGEST_ADMIN_TOKEN=REPLACE-ME

# Background ingest ticker interval (Go duration). 0/unset → ticker OFF
# (manual-trigger only). Recommended V1 rollout: ship OFF, validate a handful
# of slugs via the manual endpoint, then set e.g. 6h once trusted.
# IMAGEINGEST_TICK_INTERVAL=0

# Max seeds processed per batch pass.
IMAGEINGEST_BATCH_LIMIT=25

# Codex #22 release-coordination gate. Keep false until the iOS Settings →
# Credits page (which renders credits.json) is LIVE: while false, only CC0 /
# Public-domain images are uploaded (no attribution required → compliant);
# CC-BY / CC-BY-SA candidates are recorded deferred_attribution and uploaded
# only after this flips true. Flipping it ON before the Credits page exists
# would serve attribution-required images with no visible credit (a license
# violation). NOT a permanent BY/SA-off switch — it re-processes deferred rows.
IMAGEINGEST_ALLOW_ATTRIBUTION_LICENSES=false
